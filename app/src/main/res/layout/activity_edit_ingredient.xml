<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Ingredient"
        android:textSize="26sp"
        android:textStyle="bold"
        android:paddingBottom="20dp" />

    <EditText
        android:id="@+id/editName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name"
        android:inputType="text"
        android:padding="12dp" />

    <EditText
        android:id="@+id/editQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity"
        android:inputType="numberDecimal"
        android:padding="12dp" />

    <EditText
        android:id="@+id/editUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (kg, g, litres, etc.)"
        android:inputType="text"
        android:padding="12dp" />

    <EditText
        android:id="@+id/editExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry date (optional)"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnUpdateIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Ingredient"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnDeleteIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Ingredient"
        android:layout_marginTop="10dp" />

</LinearLayout>